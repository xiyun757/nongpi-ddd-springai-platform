<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nongpi.fulfillment</groupId>
        <artifactId>nongpi-fulfillment</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>lot</artifactId>
    <name>lot</name>
    <description>农批履约中台 — 批次管理模块（Lot DDD 限界上下文）</description>

    <dependencies>
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>inventory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Web MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Redisson — 唯一的 Redis 客户端
             - 分布式锁（OutboundService）
             - FEFO 缓存（FefoCache，RScoredSortedSet）
             redisson-spring-boot-starter 传递依赖 spring-boot-starter-data-redis，
             因此 Spring Boot 的 RedisAutoConfiguration 仍然生效（RedisTemplate/Reactive
             会用 RedissonConnectionFactory 作为底层连接工厂），但项目代码不再直接依赖
             StringRedisTemplate API。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>3.51.0</version>
        </dependency>

        <!-- MyBatis-Plus JSqlParser（3.5.12+ 分页所需） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>3.5.17</version>
        </dependency>
    </dependencies>
</project>