<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nongpi.fulfillment</groupId>
        <artifactId>nongpi-fulfillment</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>bootstrap</artifactId>
    <name>bootstrap</name>
    <description>农批履约中台 — 启动模块（聚合所有子模块，负责启动 Spring Boot 应用）</description>

    <dependencies>
        <!-- 聚合所有业务模块 -->
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>lot</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>inventory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>alert</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>sku</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.nongpi.fulfillment</groupId>
            <artifactId>ai</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.nongpi.fulfillment.NongpiFulfillmentApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>